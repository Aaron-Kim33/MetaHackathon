{
  "name": "reel-talk-popout",
  "version": "0.1.2",
  "private": true,
  "type": "module",
  "description": "Standalone pop-out photo editor developed during the Meta hackathon",
  "scripts": {
    "start": "node scripts/start.mjs",
    "reload": "node scripts/reload.mjs",
    "api": "node --env-file-if-exists=.env server/index.mjs",
    "setup:model": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/setup-model.ps1",
    "check:model": "node scripts/check-model.mjs",
    "test": "node --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "fixture": "node scripts/fixture.mjs",
    "dev": "node scripts/dev.mjs",
    "build:android": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-android.ps1",
    "share:android": "node scripts/share-android.mjs",
    "setup:cutout": "node scripts/setup-cutout-model.mjs",
    "setup:depth": "node scripts/setup-depth-model.mjs"
  },
  "dependencies": {
    "@huggingface/transformers": "^3.8.1",
    "@meta-sam/parser": "0.1.0",
    "expo": "~58.0.17",
    "expo-constants": "~58.0.13",
    "expo-dev-client": "~58.0.16",
    "expo-file-system": "~58.0.10",
    "expo-gl": "~58.0.3",
    "expo-image-picker": "~58.0.10",
    "expo-media-library": "~58.0.11",
    "expo-sensors": "~58.0.4",
    "expo-sharing": "~58.0.20",
    "expo-status-bar": "~58.0.4",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-svg": "15.16.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "toqr": "0.1.1",
    "typescript": "~6.0.3"
  },
  "main": "index.ts",
  "engines": {
    "node": ">=24"
  }
}
